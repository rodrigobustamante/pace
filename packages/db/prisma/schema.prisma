// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String         @id @default(cuid())
  stravaAthleteId   Int            @unique
  name              String
  email             String?
  profileImageUrl   String?
  maxHR             Int?
  restingHR         Int?
  accessToken       String
  refreshToken      String
  tokenExpiresAt    DateTime
  preferredModel    String        @default("gemini-2.5-flash")
  activities        Activity[]
  coachInsights     CoachInsight[]
  coachChats        CoachChat[]
  goals             Goal[]
  trainingPlans     TrainingPlan[]
  trainingDays      TrainingDay[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Activity {
  id           String   @id @default(cuid())
  stravaId     BigInt   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id])

  // Core
  name         String
  type         RunType
  date         DateTime

  // Performance
  distanceM    Float
  durationSec  Int
  paceSeckm    Int
  avgHRbpm     Int?
  maxHRbpm     Int?
  cadenceRpm   Int?
  elevationM   Float?
  caloriesKcal Int?

  // Strava raw
  stravaData   Json

  // Computed
  tss          Float?
  feel         Int?

  createdAt    DateTime @default(now())
}

model CoachInsight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  refId     String?
  content   Json
  createdAt DateTime @default(now())
  expiresAt DateTime
}

enum RunType {
  easy
  tempo
  long
  workout
  race
  strength
  unknown
}

enum GoalType {
  race_5k
  race_10k
  half_marathon
  marathon
  custom
}

model Goal {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  goalType     GoalType
  targetDate   DateTime
  isActive     Boolean       @default(true)
  /// Free-text race location, e.g. "Madrid" or "Santiago de Chile"
  location     String?
  /// Race priority: "A" = main/peak race, "B" = secondary, "C" = training race
  priority     String        @default("A")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  trainingPlan TrainingPlan?

  @@index([userId])
  @@index([userId, isActive, targetDate])
}

model TrainingPlan {
  id          String        @id @default(cuid())
  goalId      String        @unique
  goal        Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedAt DateTime      @default(now())
  days        TrainingDay[]

  @@index([userId])
}

model TrainingDay {
  id          String       @id @default(cuid())
  planId      String
  plan        TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime     @db.Date
  title       String
  description String
  workoutType RunType
  durationMin Int
  targetPace  String?
  targetZone  String?
  willTrain   Boolean?
  createdAt   DateTime     @default(now())

  @@unique([planId, date])
  @@index([userId])
}

model CoachChat {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  role           String   // "user" | "model"
  content        String
  createdAt      DateTime @default(now())

  @@index([userId, conversationId, createdAt])
  @@index([userId, createdAt])
}
